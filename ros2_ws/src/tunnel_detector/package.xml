<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tunnel_detector</name>
  <version>0.1.0</version>
  <description>
    Детектор посторонних объектов в тоннеле метро по облаку точек 3D-лидара:
    выход из габарита поезда относительно локальной оси пути, публикация
    препятствий (MarkerArray) и телеметрии (JSON).
  </description>
  <maintainer email="hackathon@example.com">Tunnel detector team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>